// NewLife GPI — Prisma schema
//
// Sources reconciled here (see LOGS.md "Schema & RLS" entry for the full
// cross-check against existing frontend code):
//   - This message's Property / PaymentLedger / Role / RentalStage types
//   - ARCHITECTURE.md: multi-tenancy mandate (every table needs tenant_id),
//     the `encrypted_api_keys` BYOK table shape
//   - CLAUDE.md (parent): the `ai_logs` self-observability table shape
//
// Auth identity: Clerk (not Supabase Auth). `User.id` is the Clerk user id
// string (e.g. "user_2abc...") used as-is, not a generated UUID — see the
// matching note in the RLS migration for how Postgres resolves this via
// Supabase's Third-Party Auth (Clerk) JWT integration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer supports
// `url`/`directUrl` directly in the schema file's datasource block —
// confirmed via `prisma validate`, not assumed).
datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────
//
// Role, PaymentStatus, and ApiKeyStatus are deliberately NOT Prisma `enum`
// blocks, unlike the ones below — see the comment on User.role for why.

/// Matches CLAUDE.md's `ai_logs.status` ("running|success|failed") as a real
/// enum instead of an unconstrained varchar — a deliberate tightening, not a
/// deviation; the original doc's three values are preserved exactly.
enum AiLogStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ── Tenancy & identity ──────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  /// Set only when this tenant is backed by a real Clerk Organization
  /// (src/app/api/webhooks/clerk/route.ts's organization.created /
  /// organizationMembership.* handling) rather than the default
  /// one-tenant-per-signup path. Nullable: every pre-existing tenant,
  /// including personal accounts going forward, has no organization behind
  /// it and stays that way unless an admin actually creates one.
  clerkOrgId String? @unique @map("clerk_org_id")

  users                  User[]
  properties             Property[]
  propertyOwnerships     PropertyOwnership[]
  paymentLedgers         PaymentLedger[]
  encryptedApiKeys       EncryptedApiKey[]
  aiLogs                 AiLog[]
  constructionMilestones ConstructionMilestone[]
  visaSteps              VisaStep[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  rentalStageRecords     RentalStageRecord[]
  documents              Document[]
  activities             Activity[]
  savedViews             SavedView[]
  contacts               Contact[]
  deals                  Deal[]
  automationRules        AutomationRule[]

  @@map("tenants")
}

/// Mirrors the Clerk user, synced via Clerk webhooks (user.created/updated)
/// using the Supabase service-role key, which bypasses RLS — end users never
/// write to this table directly through the client. `id` is the Clerk user
/// id itself (text, e.g. "user_2abc..."), not a generated UUID: it must
/// equal the JWT `sub` claim exactly for RLS in the migration to resolve
/// tenant_id correctly.
model User {
  id        String   @id @map("clerk_user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String   @unique
  /// String, not a Prisma `enum Role`, even though users.role is genuinely
  /// constrained to ADMIN/TENANT/INVESTOR at the database level (see the
  /// `check` constraint in supabase/migrations/0001_init.sql). Prisma 7's
  /// "prisma-client" generator + @prisma/adapter-pg requires a REAL native
  /// Postgres enum type to exist for any Prisma `enum` field — it casts
  /// query parameters as `$1::"Role"` unconditionally. This project's
  /// migrations deliberately use `text + check` everywhere instead (see
  /// every migration file's own header comment on why), so that cast always
  /// fails at runtime with `type "public.Role" does not exist` — confirmed
  /// directly against the live database, not assumed; every unit test using
  /// a mocked Prisma client stayed green throughout because the mismatch
  /// only surfaces against a real Postgres connection. `Role` is now a
  /// plain exported const (src/lib/auth/role.ts) instead, matching the
  /// pattern RentalStage/PropertyStatus already use on the Supabase-path
  /// side of this codebase for the same reason.
  role      String   @default("TENANT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Synced from the webhook payload's data.first_name/last_name — added to
  /// back getTenantClients() (src/lib/data/clients.ts), which needs a real
  /// display name for the admin client table. Nullable: Clerk allows a user
  /// with no name set (email-only), and both were absent from this table
  /// entirely until now, so there is no correct non-null value to backfill.
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  /// Timestamp of the Clerk webhook event that last wrote this row (from
  /// the event payload's own `data.updated_at`, not `updatedAt` above,
  /// which is Prisma's own now()-on-write timestamp) — lets the webhook
  /// handler detect and skip an out-of-order/stale event instead of
  /// letting a delayed event overwrite a newer one. Nullable: rows that
  /// existed before this column was added have no such record yet, which
  /// correctly means "always process the next update," not "always stale."
  lastSyncedAt DateTime? @map("last_synced_at")

  /// Admin-maintained client profile fields. Deliberately stored here rather
  /// than in Clerk's `publicMetadata`: the stated goal is that every usable
  /// datum lives in this database so it can be joined and analysed, and
  /// metadata on an external identity provider is queryable only one user at
  /// a time. Name and email are the opposite case — Clerk owns those, they
  /// arrive by webhook, and duplicating them as editable columns here would
  /// create two sources of truth that drift.
  ///
  /// All nullable with no backfill: every existing client predates these
  /// columns and there is no correct value to invent for them. `nationality`
  /// is free text rather than an ISO country code because the admin entering
  /// it is typing what a passport says, not picking from a list this app
  /// does not have.
  phone          String?   @map("phone")
  nationality    String?   @map("nationality")
  passportNumber String?   @map("passport_number")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  /// Admin-only free text. Never rendered on the client's own pages — see
  /// getClientProfile()/getOwnClientProfile() in src/lib/data/clients.ts,
  /// which are two separate functions precisely so this field cannot leak
  /// into a client-facing view by someone reusing the wrong one.
  adminNotes     String?   @map("admin_notes")

  /// Timestamp of the last organizationMembership.* webhook event that wrote
  /// this row's tenantId/role — deliberately a SEPARATE column from
  /// lastSyncedAt above, not a shared one. lastSyncedAt is driven by the
  /// independent user.* event stream with its own cadence; comparing two
  /// unrelated event streams against one shared timestamp would produce
  /// false-stale/false-fresh results for whichever stream didn't write it
  /// last. Nullable: a user who has never been part of a Clerk Organization
  /// has no such event to record yet.
  orgMembershipSyncedAt DateTime? @map("org_membership_synced_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  propertyOwnerships PropertyOwnership[]
  paymentLedgers     PaymentLedger[]
  visaSteps          VisaStep[]
  notifications      Notification[]
  rentalStageRecords RentalStageRecord[]

  @@index([tenantId])
  @@map("users")
}

// ── Domain ───────────────────────────────────────────────────────

model Property {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  name           String
  address        String
  area           String
  totalUnits     Int            @map("total_units")
  availableUnits Int            @map("available_units")
  deliveryDate   DateTime       @map("delivery_date") @db.Date
  contractDate   DateTime       @map("contract_date") @db.Date
  floor          Int
  sqm            Float
  energyClass    String         @map("energy_class")
  imageUrl       String         @map("image_url")
  /// String, not a Prisma `enum PropertyStatus` — same root cause and fix as
  /// User.role (see that field's comment): Prisma 7's generator requires a
  /// real native Postgres enum type for any Prisma `enum` field, and
  /// properties.status is `text + check` like every other status column in
  /// this schema. Latent until admin property create/edit (src/lib/data/
  /// projects.ts's createProperty/updateProperty) became the first Prisma
  /// write to this column.
  status         String         @default("PLANNING")

  /// Whether this property is part of the lettings inventory.
  ///
  /// Added because nothing in this schema could previously answer "which
  /// properties are we letting?" at all: the ten-stage letting workflow
  /// (RentalStageRecord) hangs off a *user*, so a property only became
  /// visible as a rental once someone had already ticked its first stage —
  /// there was no way to see a unit that is for rent but not yet started.
  /// An explicit admin-set flag makes the inventory a first-class fact
  /// rather than something inferred from downstream activity.
  ///
  /// Defaults false: a property is for sale unless someone says otherwise,
  /// which is the correct starting value for every existing row.
  listedForRental Boolean       @default(false) @map("listed_for_rental")

  mapUrl         String         @map("map_url")
  pptUrl         String?        @map("ppt_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  propertyOwnerships     PropertyOwnership[]
  paymentLedgers         PaymentLedger[]
  constructionMilestones ConstructionMilestone[]

  @@index([tenantId])
  @@map("properties")
}

/// Join model between User and Property — not given explicitly in this
/// message's type list, but required to store `rentalStage` at all (it has
/// to belong to a specific user's specific property, not a bare scalar) and
/// consistent with PaymentLedger already pairing userId + propertyId.
model PropertyOwnership {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id")
  propertyId String   @map("property_id") @db.Uuid
  /// `rentalStage` was removed here in migration 0008. It was a single
  /// scalar holding one of ten PURCHASE-workflow values
  /// (RESERVATION…RENTAL_ACTIVE); the business process it now has to model
  /// is a LETTING workflow with per-stage status, attachments and offer
  /// details, which a scalar cannot express. See RentalStageRecord.

  /// The real commercial facts of the sale, admin-entered.
  ///
  /// `createdAt` below is when an admin recorded the ownership *in this
  /// application*, which for anything sold before the app existed is not the
  /// date of sale. Keeping them as separate columns means neither has to lie:
  /// createdAt stays an honest system timestamp, and saleDate is the business
  /// fact. Both nullable, no backfill — copying createdAt into saleDate would
  /// manufacture a sale date that nobody verified.
  ///
  /// Decimal, not Float, unlike PaymentLedger.amount: that column predates
  /// this one and is left alone rather than migrated as a side effect, but
  /// binary floating point is the wrong type for money and new money columns
  /// in this schema use Decimal (matching RentalStageRecord.offerPrice).
  saleDate  DateTime? @map("sale_date") @db.Date
  salePrice Decimal?  @map("sale_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
  @@index([tenantId])
  @@map("property_ownerships")
}

model PaymentLedger {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  userId        String   @map("user_id")
  amount        Float
  dueDate       DateTime @map("due_date") @db.Date
  isDelayed     Boolean  @default(false) @map("is_delayed")
  penaltyAmount Float    @default(0) @map("penalty_amount")
  /// String, not a Prisma `enum PaymentStatus` — see the identical note on
  /// User.role above; same root cause, same fix.
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// Cumulative amount paid toward this installment so far. Added because
  /// recordTenantPayment() (src/lib/data/ledgers.ts) needs to represent a
  /// partial payment — the existing PENDING/PAID/OVERDUE status alone can
  /// only say "fully paid or not," it can't say "€400 of €1000 paid." A
  /// row is fully settled once amountPaid >= amount, at which point status
  /// flips to PAID; a partial payment updates this without changing status.
  /// Defaults to 0, not nullable: every existing row genuinely has "zero
  /// paid so far" as its correct starting value, unlike lastSyncedAt above
  /// (which had no correct non-null default to backfill).
  amountPaid Float @default(0) @map("amount_paid")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([propertyId])
  @@index([userId])
  @@map("payment_ledger")
}

/// Construction-progress tracker backing the "Construction" milestone-tracker
/// screen (FRONTEND_SPEC.md: Card/ProgressBar/Badge/Tabs, MilestoneRow rows —
/// label/progress/status per row). No userId: a milestone describes the
/// property's own build progress, not any one buyer's data, so
/// getPropertyMilestones() (src/lib/data/construction.ts) takes only
/// tenantId + propertyId, matching getProjectById()'s shape in
/// src/lib/data/projects.ts.
///
/// tenantId is not part of this model's originating field list (only
/// propertyId was specified) but is added anyway: ARCHITECTURE.md's
/// multi-tenancy mandate ("every table needs tenant_id") is a standing,
/// project-wide rule, and every sibling tracking table already stores
/// tenantId redundantly alongside a propertyId/userId FK for the same reason
/// (PropertyOwnership, PaymentLedger) — defense-in-depth filtering/indexing
/// and a real RLS boundary, not something left to be derived only through a
/// join at query time. getPropertyMilestones() still does the requested
/// "verify the property belongs to this tenant first" check against
/// Property directly before ever querying this table.
model ConstructionMilestone {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  title          String
  description    String?
  /// String, not a Prisma `enum MilestoneStatus` — same root cause and fix
  /// as User.role. construction_milestones.status is `text + check`, never
  /// a native Postgres enum. Latent until admin milestone create/update
  /// (src/lib/data/construction.ts's createMilestone/updateMilestoneStatus)
  /// became the first Prisma write to this column.
  status         String          @default("PENDING")
  targetDate     DateTime        @map("target_date") @db.Date
  completionDate DateTime?       @map("completion_date") @db.Date
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@map("construction_milestones")
}

/// Golden Visa application progress tracker backing the "Golden Visa" 5-step
/// timeline screen (FRONTEND_SPEC.md: TimelineStep rows — numbered/checked
/// circle + connector + title + date badge + optional description).
///
/// Unlike ConstructionMilestone above, this is per-user by design (each
/// buyer's own visa application), matching PropertyOwnership/PaymentLedger's
/// existing tenantId + userId pairing — getUserVisaSteps()
/// (src/lib/data/visa.ts) filters strictly by both, the same reasoning as
/// getUserLedger() in src/lib/data/ledgers.ts.
///
/// `@@unique([userId, stepOrder])` is not in this model's originating field
/// list either, but mirrors PropertyOwnership's own `@@unique([userId,
/// propertyId])` precedent: a 5-step timeline with two different rows
/// claiming to be the same user's "step 3" is a data integrity bug this
/// constraint prevents outright rather than leaving to application code.
model VisaStep {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  userId      String          @map("user_id")
  stepOrder   Int             @map("step_order")
  title       String
  description String?
  /// String, not a Prisma `enum MilestoneStatus` — same root cause and fix
  /// as User.role (shares the same underlying status vocabulary as
  /// ConstructionMilestone above, but kept as its own local const in
  /// src/lib/data/visa.ts rather than a shared import, matching this
  /// project's established one-file-one-const convention). visa_steps.status
  /// is `text + check`, never a native Postgres enum. Latent until admin
  /// visa-step create/update (createVisaStep/updateVisaStepStatus) became
  /// the first Prisma write to this column.
  status      String          @default("PENDING")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, stepOrder])
  @@index([tenantId])
  @@index([userId])
  @@map("visa_steps")
}

/// Backs the TopNav bell (src/components/ui/TopNav.tsx), which previously
/// had no data behind it at all — a static button with no onClick. Kept
/// deliberately minimal (message + read flag, no "type"/"link" taxonomy):
/// nothing in this app yet has more than one kind of event worth notifying
/// on, so a richer schema would be speculative. Per-user, not per-tenant
/// broadcast: notifications are scoped to whichever single account a real
/// event happened to (matching PaymentLedger/VisaStep's tenantId + userId
/// pairing), not shared across everyone in a tenant.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

// ── Platform (ARCHITECTURE.md / CLAUDE.md mandated) ────────────

/// BYOK credential storage — original raw-cryptographic shape matched
/// ARCHITECTURE.md exactly; label/status/maskedKey added to realign with
/// ApiKeyCard.tsx's actual prop requirements (see LOGS.md audit entry).
/// Decryption happens server-side only; see ARCHITECTURE.md for the
/// validation rules this table backs.
///
/// NOTE: there is no relation to User here to "keep" — there never was one.
/// BYOK keys are tenant-level shared credentials (one organization's own AI
/// provider account), not per-user, which is why this only ever related to
/// Tenant. Preserved as-is rather than inventing a new per-user ownership
/// field the request assumed already existed.
model EncryptedApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  provider     String
  label        String
  maskedKey    String    @map("masked_key")
  /// String, not a Prisma `enum ApiKeyStatus` — see the identical note on
  /// User.role above; same root cause, same fix.
  status       String    @default("ACTIVE")
  encryptedKey String    @map("encrypted_key")
  encryptionIv String    @map("encryption_iv")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("encrypted_api_keys")
}

/// Self-observability log — shape matches CLAUDE.md exactly (tenant_id added
/// per ARCHITECTURE.md's later, stricter multi-tenancy mandate, which
/// explicitly lists ai_logs as requiring it).
model AiLog {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  agentAction  String      @map("agent_action")
  status       AiLogStatus @default(RUNNING)
  inputTokens  Int?        @map("input_tokens")
  outputTokens Int?        @map("output_tokens")
  cost         Decimal?    @db.Decimal(10, 4)
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ai_logs")
}

/// Append-only record of every mutation an admin makes, so the history of a
/// change is not destroyed by the change itself. Before this existed, every
/// admin edit overwrote in place: `updatedAt` said *when* a row last changed
/// but never *what* changed, *from what*, or *by whom* — which made the
/// question the business actually wants answered ("how long does a stage
/// take?", "who marked this done?") permanently unanswerable, and
/// unbackfillable after the fact.
///
/// Shape follows AiLog (append-only: `createdAt` only, no `updatedAt`; a
/// `Json?` metadata escape hatch) but deliberately NOT its `status` field —
/// `AiLogStatus` is this schema's one real Prisma `enum` and is the exact
/// bug class documented at length on User.role. Everything here is String.
///
/// Deliberately generic (entityType + entityId as plain strings rather than
/// a real FK per table): a typed relation would need one nullable FK column
/// per audited table, and every new audited table would then require a
/// migration. The tradeoff is that entityId is not referentially enforced —
/// accepted, because an audit row must survive its subject being deleted,
/// which a real FK with cascade would actively prevent.
model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The Clerk user id of whoever performed the action, always resolved
  /// server-side from the session — never accepted as a parameter, same
  /// rule as tenantId (see ARCHITECTURE.md).
  actorUserId String @map("actor_user_id")

  /// e.g. "Property", "RentalStageRecord", "PaymentLedger" — the model name.
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// CREATE | UPDATE | DELETE. String + check, per this schema's convention.
  action String

  /// Which field changed, and its before/after values, for UPDATE actions.
  /// All nullable: a CREATE has no single field or prior value. Values are
  /// stringified rather than typed — this table spans every model, so there
  /// is no one column type that fits, and analysis queries cast as needed.
  field    String?
  oldValue String? @map("old_value")
  newValue String? @map("new_value")

  /// Room for context that isn't a single field change (e.g. the full
  /// payload of a CREATE), without a migration per shape.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One row per rental workflow stage a client has actually reached.
///
/// Replaces the former single `PropertyOwnership.rentalStage` scalar, which
/// could only express "the client is at stage N, so everything before it is
/// implicitly done" — a linear model that cannot represent stages completed
/// out of order, cannot attach a document to a stage, and cannot carry the
/// structured Offer fields (price/duration/comments) the real workflow needs.
/// Modelled on VisaStep, the closest existing per-user progress table.
///
/// NO ROW MEANS PENDING. The canonical ten stages live in code
/// (src/lib/data/rentalStages.ts), not in this table; a row is written only
/// once a stage is actually touched. That keeps ten rows per client of pure
/// "nothing has happened yet" out of the table, avoids any backfill, and
/// means revising the stage list later cannot strand orphaned rows. Every
/// real transition is timestamped in AuditLog regardless.
model RentalStageRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id")

  /// Matches a key in the canonical list in src/lib/data/rentalStages.ts.
  /// Intentionally NOT constrained by a database check: the stage list is
  /// expected to change as the business process does, and a check constraint
  /// would turn each revision into a migration. Validated in application
  /// code against the canonical list instead, on both read and write.
  stageKey String @map("stage_key")

  /// Denormalised display order, copied from the canonical list at write
  /// time so ordering queries don't need the application list. The list
  /// remains the source of truth if the two ever disagree.
  stageOrder Int @map("stage_order")

  /// PENDING | DONE. Two states, not the three MilestoneStatus uses — the
  /// requested workflow is explicitly binary per stage.
  status String @default("PENDING")

  completedAt DateTime? @map("completed_at")

  /// Supabase Storage object path (private bucket) and the original
  /// filename for display. Both null unless this stage has a file slot and
  /// something was uploaded. The path is not a URL: downloads are served
  /// through short-lived signed URLs generated server-side, so a leaked
  /// path is not a leaked file.
  attachmentPath     String? @map("attachment_path")
  attachmentFilename String? @map("attachment_filename")

  /// Structured Offer fields — used only by the OFFER stage. Nullable
  /// columns on this shared table rather than a separate one-row table:
  /// exactly one stage uses them, and a dedicated table for three fields
  /// would add a join and a model for no real gain. Duration is an integer
  /// month count rather than free text specifically so it stays analysable.
  offerPrice          Decimal? @map("offer_price") @db.Decimal(12, 2)
  offerDurationMonths Int?     @map("offer_duration_months")
  offerComments       String?  @map("offer_comments")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, stageKey])
  @@index([tenantId])
  @@index([userId])
  @@map("rental_stage_records")
}

/// A stored file (PDF or image) attached to any record in the system — lease
/// agreements, payment receipts, construction progress photos, passports.
///
/// Polymorphic (`entityType` + `entityId` as plain strings) for the same
/// reason AuditLog is, and with the same accepted tradeoff: a typed relation
/// would need one nullable FK column per attachable table, and every new
/// attachable table would then require a migration. See AuditLog's comment.
///
/// This does NOT replace RentalStageRecord.attachmentPath. That column models
/// "the single document that evidences this specific workflow stage" — a
/// one-to-one slot the stage tracker renders inline, with the stage's own
/// `slot` deciding which content types are legal. This table models "every
/// file anyone attached to this record", which is many-to-one and has no
/// per-slot type rule. Collapsing the two would make the stage tracker query
/// a list and pick one, which is exactly the ambiguity the slot design
/// avoids. Both write to the same bucket through src/lib/storage.ts.
model Document {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Matches a key in the canonical list in src/lib/documents.ts. Not
  /// constrained by a database check, same reasoning as
  /// RentalStageRecord.stageKey: the category list is business vocabulary
  /// and expected to change. Validated in application code on write.
  category String

  /// Supabase Storage object path in the private bucket — NOT a URL.
  /// Downloads are served through short-lived signed URLs generated
  /// server-side, so a leaked path is not a leaked file.
  storagePath String @map("storage_path")
  filename    String
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")

  description String?

  /// Whether a non-admin may see this file on their own pages.
  ///
  /// Defaults FALSE, and that default is load-bearing. Admins attach files
  /// to client records that clients must not see (internal valuations, notes
  /// on a passport scan) alongside ones they should (their signed lease).
  /// Because Prisma bypasses RLS entirely, nothing below the application
  /// layer will catch a mistake here — so the safe value is the default and
  /// sharing is the deliberate act, never the other way round. Enforced by
  /// getEntityDocuments() vs getClientVisibleDocuments() being two separate
  /// functions, per the rule in ARCHITECTURE.md.
  visibleToClient Boolean @default(false) @map("visible_to_client")

  /// Clerk user id of the uploader, always resolved server-side from the
  /// session — never accepted as a parameter, same rule as tenantId.
  uploadedByUserId String @map("uploaded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("documents")
}

/// A human interaction recorded against any record — a call, an email, a
/// meeting, a note, or a task.
///
/// This is the piece the system had no representation for at all. Before it,
/// the only free-text field anywhere was `users.admin_notes`: one blob per
/// client, overwritten on every edit, with no author, no timestamp and no
/// subject. "When did we last speak to this buyer, and what did they say?"
/// was unanswerable, and unanswerable retroactively — the data was never
/// written down to begin with.
///
/// DELIBERATELY SEPARATE FROM AuditLog, though both are append-ish records
/// with a polymorphic subject and both are rendered in one merged feed
/// (getRecordTimeline in src/lib/data/activities.ts). They differ in the one
/// way that matters: an audit row is written BY the system as the factual,
/// immutable consequence of a mutation and must never be editable, whereas an
/// activity is written BY a person, is their fallible account of something
/// that happened outside the system, and must be correctable. Storing both in
/// audit_logs would have meant either making audit rows editable — destroying
/// the guarantee that table exists to provide — or making typos permanent.
///
/// Polymorphic on entityType + entityId for the same reason as AuditLog and
/// Document, with the same accepted tradeoff. See AuditLog's comment.
model Activity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// CALL | EMAIL | MEETING | NOTE | TASK. String + check, per this schema's
  /// convention — never a native Postgres enum, for the reason set out at
  /// length on User.role.
  type String

  subject String
  /// The long form. Nullable: "Called, no answer" is a complete activity.
  body    String?

  /// When the interaction actually happened, which is NOT `createdAt`.
  ///
  /// Someone logging Friday's call on Monday morning needs the timeline to
  /// place it on Friday. Keeping them as separate columns means neither has
  /// to lie — createdAt stays an honest system timestamp, occurredAt is the
  /// business fact — exactly the reasoning behind PropertyOwnership.saleDate.
  ///
  /// Nullable because a TASK has not happened yet; it has a dueAt instead.
  occurredAt DateTime? @map("occurred_at")

  /// TASK only: when it is due, and when it was actually done.
  ///
  /// Nullable columns on this shared table rather than a separate Task model,
  /// the same call RentalStageRecord's offer fields make: a task IS an
  /// activity for every purpose this app has — it appears in the same feed,
  /// attaches to the same records, and is written by the same composer — and
  /// a second table would add a model and a union type to every read for two
  /// columns.
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")

  /// Clerk user id of the author, always resolved server-side from the
  /// session — never accepted as a parameter, same rule as tenantId.
  createdByUserId String @map("created_by_user_id")

  /// Whether the client may see this on their own pages. Same default and
  /// same reasoning as Document.visibleToClient: an internal note about a
  /// buyer's negotiating position is the common case, so the safe value is
  /// the default and sharing is the deliberate act.
  visibleToClient Boolean @default(false) @map("visible_to_client")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  /// Backs the "my open tasks" query, which filters on completion and orders
  /// by due date across every entity at once.
  @@index([tenantId, dueAt])
  @@map("activities")
}

/// A named, reusable table configuration — "Overdue payments", "Athens units
/// still available" — as monday's saved board views are.
///
/// PER USER, not per tenant, and that is the whole design. Two admins looking
/// at the same roster want different working sets, and a shared view that one
/// of them silently re-sorts is worse than no saved views at all. Sharing a
/// view with a colleague is a feature this deliberately does not have yet;
/// adding it later means adding a nullable `sharedWithTenant` flag, not
/// unpicking an ownership model.
///
/// `config` is Json rather than a set of typed columns. The shape is defined
/// and validated in src/lib/views.ts (parseViewConfig), which drops anything
/// it does not recognise — so a view saved against an older shape of the app
/// degrades to a partial view rather than breaking the page that loads it.
/// Typed columns would have made every change to the filter model a
/// migration, for data that is only ever read back by the one function that
/// wrote it.
model SavedView {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Clerk user id of the owner, always resolved server-side from the
  /// session — never accepted as a parameter, same rule as tenantId.
  userId String @map("user_id")

  /// Which table this view belongs to, e.g. "clients", "properties".
  /// A plain string for the same reason Document.category is: the set of
  /// tables grows as the app does, and a check constraint would make each
  /// addition a migration.
  scope String

  name String

  config Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// One name per user per table. Saving over an existing name is an update,
  /// not a second row that shadows the first in a list.
  @@unique([userId, scope, name])
  @@index([tenantId])
  @@index([userId, scope])
  @@map("saved_views")
}

// ── Pipeline (pre-sale) ─────────────────────────────────────────────
//
// Everything above this line models a client the business ALREADY HAS: their
// unit, their payments, their visa, their lettings workflow. Nothing modelled
// the person who has not bought yet, and there was no way to add one — a
// `User` row is written only by the Clerk webhook handler
// (src/app/api/webhooks/clerk/route.ts), so a person could not exist in this
// system until they created an account. The two models below are the missing
// front half.

/// A person the business is talking to who is not (yet) a signed-up client.
///
/// SEPARATE FROM User, DELIBERATELY, and this is the central design decision
/// of the pipeline. `User.id` IS the Clerk user id — the schema says so and
/// RLS depends on it — so a User cannot exist before a Clerk account does.
/// Making prospects Users would have meant either provisioning a Clerk
/// account for everyone who ever left a phone number, or making `User.id`
/// nullable and unpicking the identity model the whole application rests on.
///
/// The two are joined by `clerkUserId` at the moment of conversion, which is
/// the honest shape: a contact is a record the business owns, an account is
/// something the person themselves creates, and the gap between the two is
/// real rather than a modelling artefact.
model Contact {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  email     String?
  phone     String?

  nationality String?

  /// Where the lead came from — "Referral", "Website", "Portal". Free text,
  /// not an enum: every business invents its own channels and a check
  /// constraint would make each new one a migration.
  source String?

  notes String?

  /// Set when this contact becomes a signed-up client, linking the two
  /// halves of their history so the calls logged before they bought stay
  /// attached to them afterwards.
  ///
  /// Nullable and NOT unique-per-tenant but globally unique: one Clerk
  /// account must never be claimed by two contact records, which is exactly
  /// the duplicate this constraint prevents. No FK to User: the link is set
  /// by matching email when the webhook fires, and a hard FK would make
  /// deleting a user destroy the pre-sale history rather than orphan it.
  clerkUserId String? @unique @map("clerk_user_id")

  /// Which admin owns the relationship. Clerk user id, no FK, for the same
  /// reason AuditLog.actorUserId has none.
  ownerUserId String? @map("owner_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  deals  Deal[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("contacts")
}

/// One opportunity to sell one thing to one contact.
///
/// Separate from Contact because the two genuinely differ in cardinality: a
/// contact who buys an apartment and later a second unit is one relationship
/// and two deals, and collapsing them would make the second purchase either
/// overwrite the first or require a duplicate contact record.
model Deal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  contactId String @map("contact_id") @db.Uuid

  /// The unit under discussion, once there is one. Nullable: a deal exists
  /// from the first conversation, long before a specific unit is chosen, and
  /// forcing a property at creation would mean inventing one.
  propertyId String? @map("property_id") @db.Uuid

  title String

  /// Matches a key in the canonical list in src/lib/pipeline.ts. String +
  /// check, per this schema's convention — see the note on User.role for why
  /// this is never a native Postgres enum. It DOES carry a check constraint,
  /// unlike documents.category: the pipeline stages are the spine of the
  /// board and a typo'd stage would silently create a phantom column.
  ///
  /// The vocabulary is the business's real acquisition funnel — LEAD,
  /// ZOOM_MEETING, ATHENS_VISIT, POWER_OF_ATTORNEY, BUYER, LOST — replacing
  /// the generic B2B stages this column shipped with in 0013. See
  /// 0015_pipeline_real_funnel.sql for the remapping and why OFFER and
  /// RESERVATION were mapped *back* to ATHENS_VISIT rather than forward.
  stage String @default("LEAD")

  /// Expected value. Decimal, not Float — see PropertyOwnership.salePrice on
  /// why binary floating point is the wrong type for money. Nullable: a lead
  /// with no number attached is a real and common state, and defaulting to
  /// zero would drag every forecast down with fictional certainty.
  value Decimal? @db.Decimal(12, 2)

  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  /// Set when the deal leaves the board. Both nullable and mutually
  /// exclusive in practice; the pair is kept rather than one "closedAt" plus
  /// a status because "when did we win this" and "when did we lose it" are
  /// asked separately and answering either from a shared column requires
  /// re-deriving the outcome every time.
  wonAt      DateTime? @map("won_at")
  lostAt     DateTime? @map("lost_at")
  lostReason String?   @map("lost_reason")

  ownerUserId String? @map("owner_user_id")

  /// Position within its stage column, so a manually reordered board keeps
  /// its order. Float, not Int, specifically so a card dropped between two
  /// others gets the midpoint of their positions and only ONE row is
  /// rewritten — integer positions would require renumbering every card
  /// below the insertion point on every drag.
  position Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([contactId])
  @@map("deals")
}

/// One "when X, do Y" recipe, as monday's automations are.
///
/// WHY THIS TABLE EXISTS RATHER THAN HARD-CODED RULES: the conditions a
/// business wants to watch change constantly ("chase after 7 days" becomes
/// "after 4 days" the moment a deal is lost), and every such change would
/// otherwise be a deployment. Storing them makes tuning an admin action.
///
/// EVALUATION IS PULL, NOT PUSH. Nothing fires on write. A rule is evaluated
/// when `runAutomations()` is called — from the admin's own button, or from
/// an authenticated route handler a scheduler can hit. That is a deliberate
/// choice over trigger-on-mutation: a rule that fires inside a write
/// transaction can fail the write it was observing, and time-based
/// conditions ("nothing has happened for 7 days") have no write to hang off
/// at all — the interesting moment is precisely when nothing happened.
///
/// `lastRunAt` and `lastMatchCount` are stored rather than derived because
/// the alternative is scanning notifications to guess when a rule last did
/// something, and a rule that has never matched is indistinguishable from
/// one that never ran.
model AutomationRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String

  /// Matches a key in the canonical list in src/lib/automations.ts.
  /// String + check — the trigger vocabulary is a closed set the engine must
  /// know how to evaluate, so an unknown value is a bug rather than business
  /// vocabulary, and the check catches it at the database.
  trigger String

  /// The trigger's parameter, e.g. the number of idle days. Nullable: some
  /// triggers ("a payment is overdue") need no threshold.
  thresholdDays Int? @map("threshold_days")

  /// NOTIFY | CREATE_TASK. String + check, per this schema's convention.
  action String

  /// Message template for the notification or task subject. The engine
  /// substitutes {{subject}} with the affected record's name.
  messageTemplate String @map("message_template")

  enabled Boolean @default(true)

  lastRunAt      DateTime? @map("last_run_at")
  lastMatchCount Int?      @map("last_match_count")

  /// Clerk user id of whoever created it, resolved server-side.
  createdByUserId String @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("automation_rules")
}
