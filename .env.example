# Copy to .env / .env.local and fill in real values. Never commit the real
# files. Supabase is this project's database (Postgres); the app reaches it
# only through Prisma — see ARCHITECTURE.md's "Data access: Prisma only".

# --- Prisma / Postgres (Supabase) — lives in .env ---------------------------
# Project Settings → Database in the Supabase dashboard. DIRECT_URL bypasses
# the connection pooler and is used for migrations; DATABASE_URL is the
# pooled connection the app uses at runtime.
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Clerk auth — lives in .env.local ---------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Svix signing secret for src/app/api/webhooks/clerk/route.ts, from Clerk
# Dashboard → Webhooks → your endpoint → Signing Secret. NOT set yet.
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Supabase Storage (rental stage attachments) — lives in .env.local ------
# Used ONLY for file uploads/downloads (src/lib/storage.ts), never for
# database access — all data goes through Prisma via DATABASE_URL above.
#
# SUPABASE_URL: Project Settings → Data API → Project URL.
# SUPABASE_SECRET_KEY: Project Settings → API Keys → Secret keys (sb_secret_…).
#   Server-side only. Deliberately NOT prefixed NEXT_PUBLIC_ — this key
#   bypasses storage RLS and must never reach the browser.
#
# Both optional: if unset, the app runs normally and attachment slots render
# "File storage is not configured" instead of failing.
#
# One-time setup: create a PRIVATE bucket named `rental-documents`
# (Supabase Dashboard → Storage → New bucket, "Public bucket" OFF).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# NOTE: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY were removed
# on 2026-07-27 along with the Supabase PostgREST data path. They are not the
# same as the two values above: those were browser-exposed keys used to read
# tables; these are a server-only key used only for file storage.

# --- BYOK API key encryption — lives in .env ---------------------------------
# AES-256 key for src/lib/data/apiKeys.ts, base64-encoded, must decode to
# exactly 32 bytes. Generate with: openssl rand -base64 32
# NOT set yet — createTenantApiKey()/decrypting a key will throw without it.
# Rotating this value makes every previously-encrypted key undecryptable —
# there is no key-versioning in this schema, so treat it as a one-time,
# durably-stored secret, not something to regenerate casually.
API_KEY_ENCRYPTION_SECRET="base64-encoded-32-byte-key"

# --- AI features (Phase 5) ---------------------------------------------------
# Which model the Client Brief and Pipeline Monitor call. Optional; defaults to
# claude-opus-5. Must be one of the ids in src/lib/ai/models.ts — an
# unrecognized value throws on the request that used it rather than silently
# billing a different model at a different price.
#
# ⚠️ THIS SETTING DECIDES HOW CLAUDE.md's `temperature: 0.0` RULE IS HONOURED.
# Claude Opus 5 / 4.8 / 4.7 REMOVED the temperature parameter — sending it
# returns HTTP 400 — so on those models src/lib/ai/models.ts sends
# `output_config: { effort: "low" }` instead, which is Anthropic's documented
# replacement for that exact intent and also serves the rule's second stated
# reason (cost control). To have the literal parameter sent instead, set this
# to a model whose registry row says supportsTemperature: true, e.g.
# claude-opus-4-6 or claude-sonnet-4-6. No code change is needed either way.
#
# The API key itself is NOT set here — it is per-tenant, encrypted, and
# supplied by each workspace under Settings (BYOK, see ARCHITECTURE.md).
AI_MODEL="claude-opus-5"

# --- Scheduled automation runs (Phase 6) -------------------------------------
# Shared secret for GET /api/automations/run, sent as `Authorization: Bearer`.
# That route has no Clerk session, so this is its only authentication.
# Generate with: openssl rand -hex 32
#
# Leave UNSET to disable scheduled runs entirely — the route then returns 503
# and does nothing. It fails closed on purpose: an unset secret must never
# mean "no authentication required". Admins can still run rules by hand from
# /dashboard/automations regardless of this value.
AUTOMATION_RUN_SECRET=""
